{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rateguard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Mounted on a path under the main zone. Cloudflare matches the most specific
  // route first, so this wins over the labs worker's antharmaya.com/*. The old
  // hostname stays alive as a zone-level Redirect Rule — it is published in the
  // npm, PyPI and GitHub READMEs, which cannot be edited retroactively.
  "routes": [
    { "pattern": "antharmaya.com/tools/rateguard*", "zone_name": "antharmaya.com" }
  ]
}
